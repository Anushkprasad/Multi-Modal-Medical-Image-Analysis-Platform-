# ─────────────────────────────────────────────────────────────
# Multi-Modal Medical Image Analysis Platform — Backend Config
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git — it is listed in .gitignore.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your actual values
# ─────────────────────────────────────────────────────────────

# ── Gemini API ───────────────────────────────────────────────
# Your Google AI Studio API key.
# Leave blank if using GEMINI_MOCK=true.
GEMINI_API_KEY=

# Model name passed to the Gemini API.
# Default used by the app if this is not set: gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash

# Set to "true" to skip real Gemini API calls.
# The mock response has the same schema as a real response.
# Useful for local development and CI without an API key.
GEMINI_MOCK=true

# ── Database ─────────────────────────────────────────────────
# Local SQLite file (default — no PostgreSQL needed for dev/testing):
DATABASE_URL=sqlite:///./local_test.db

# PostgreSQL production example:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
